{
  "name": "dessai-backend",
  "version": "1.0.0",
  "description": "AI-native technical hiring platform backend services",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "prepare": "husky install",
    "type-check": "tsc --project tsconfig.build.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "lint:check": "eslint src --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:security": "jest --testPathPattern=security",
    "test:performance": "jest --testPathPattern=performance",
    "db:migrate": "npx prisma migrate deploy",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "docker:build": "docker build -t dessai-backend .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:db-only": "docker-compose up -d postgres redis",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "docker:verify": "node scripts/verify-docker-setup.js",
    "k8s:deploy": "kubectl apply -f k8s/",
    "ai:validate-personas": "node scripts/validate-personas.js",
    "ai:validate-prompts": "node scripts/validate-prompts.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.4.1",
    "@opentelemetry/sdk-node": "^0.41.2",
    "@prisma/client": "^6.13.0",
    "@simplewebauthn/server": "^8.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/qrcode": "^1.5.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.11.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "firebase-admin": "^11.10.1",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.4",
    "prom-client": "^14.2.0",
    "qrcode": "^1.5.4",
    "redis": "^4.6.7",
    "sharp": "^0.32.4",
    "socket.io": "^4.7.2",
    "speakeasy": "^2.0.0",
    "twilio": "^4.14.0",
    "validator": "^13.15.15",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.13.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/joi": "^17.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/long": "^4.0.2",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.19.10",
    "@types/nodemailer": "^6.4.9",
    "@types/shimmer": "^1.2.0",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.15.2",
    "@types/ws": "^8.5.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^16.3.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jiti": "^2.5.1",
    "lint-staged": "^13.2.3",
    "prettier": "^3.0.0",
    "prisma": "^6.13.0",
    "supertest": "^6.3.4",
    "testcontainers": "^9.9.1",
    "ts-jest": "^29.4.1",
    "tsc-alias": "^1.8.7",
    "tsx": "^3.12.7",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.39.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "ai-native",
    "hiring-platform",
    "technical-assessment",
    "microservices",
    "typescript",
    "node.js"
  ],
  "author": "Dessai Development Team",
  "license": "MIT"
}
